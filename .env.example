# ========================================================
# SMART CAMPUS ISSUE MANAGEMENT SYSTEM - ENVIRONMENT CONFIG
# Copy this file to .env and fill in your local credentials.
# ========================================================

# MySQL 8.0 Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_campus
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# AWS Bedrock AI Module (Optional - fallback available if disabled or unconfigured)
# Supported Bedrock model IDs:
#   anthropic.claude-3-haiku-20240307-v1:0
#   amazon.titan-text-express-v1
#   us.meta.llama3-2-3b-instruct-v1:0
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AI_ENABLED=false

# Application Settings
APP_SECRET_KEY=smartcampus-btech-dbms-secret-key-2026
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
